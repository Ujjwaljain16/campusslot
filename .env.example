# Copy to .env for local Docker Compose. Never commit the real .env file.
# These are development placeholders only, not production credentials.
POSTGRES_DB=campusslot
POSTGRES_USER=campusslot
POSTGRES_PASSWORD=change-me-locally

# The backend reads this single variable. Compose builds it from the values above.
# Format: postgresql+psycopg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql+psycopg://campusslot:change-me-locally@postgres:5432/campusslot

APP_ENV=development
LOG_LEVEL=INFO
